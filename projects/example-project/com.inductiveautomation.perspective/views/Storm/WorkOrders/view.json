{
  "custom": {"order": {"work_order_id": "", "asset": "", "summary": "", "triage_state": ""}},
  "params": {},
  "props": {"defaultSize": {"height": 600, "width": 1000}},
  "root": {
    "meta": {"name": "root"},
    "type": "ia.container.flex",
    "props": {
      "direction": "column", "justify": "flex-start", "alignItems": "stretch",
      "style": {"padding": "32px", "gap": "18px", "backgroundColor": "#f5f8fc", "color": "#1e293b"}
    },
    "children": [
      {"meta": {"name": "Title"}, "type": "ia.display.label", "position": {"basis": "48px"},
       "props": {"text": "Storm | Work-order triage", "style": {"fontSize": "28px", "fontWeight": 700}}},
      {"meta": {"name": "Instructions"}, "type": "ia.display.label", "position": {"basis": "32px"},
       "props": {"text": "Fetch WO-1042 from the Compose CMMS API and classify it in PostgreSQL."}},
      {"meta": {"name": "Ingest"}, "type": "ia.input.button", "position": {"basis": "44px"},
       "props": {"text": "Triage now · WO-1042", "style": {"backgroundColor": "#0f766e", "color": "#ffffff", "borderRadius": "6px", "fontWeight": 700}},
       "events": {"component": {"onActionPerformed": {"type": "script", "scope": "G",
         "config": {"script": "\tself.view.custom.order = storm_demo.ingest('WO-1042')"}}}}},
      {"meta": {"name": "WorkOrder"}, "type": "ia.display.label", "position": {"basis": "40px"},
       "props": {"text": "No work order triaged yet", "style": {"fontSize": "22px"}},
       "propConfig": {"props.text": {"binding": {"type": "expr", "config": {
         "expression": "if({view.custom.order.work_order_id} = '', 'No work order triaged yet', {view.custom.order.work_order_id} + ' | ' + {view.custom.order.asset} + ' | ' + {view.custom.order.triage_state})"
       }}}}},
      {"meta": {"name": "Summary"}, "type": "ia.display.label", "position": {"basis": "35px"},
       "props": {"text": ""}, "propConfig": {"props.text": {"binding": {"type": "property", "config": {
         "path": "view.custom.order.summary"
       }}}}}
    ]
  }
}
