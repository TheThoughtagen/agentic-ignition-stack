# Copy this file to .env. Never commit .env.
# Tested baseline for this starter. Do not use a floating latest tag.
IGNITION_IMAGE=inductiveautomation/ignition:8.3.9
IGNITION_PORT=8088
ACCEPT_IGNITION_EULA=Y
# Use the edition your development licence or trial supports.
IGNITION_EDITION=standard

# Local development credentials only. Use a unique value, even for a local gateway.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=replace-with-a-unique-local-password

# Set after commissioning the gateway and creating a least-privilege API token.
IGNITION_GATEWAY_URL=http://127.0.0.1:8088
IGNITION_API_TOKEN=

# BW Design Group Project Scan Endpoint module release to download locally.
PROJECT_SCAN_MODULE_VERSION=v1.0.0
# Optional local unsigned Git module build. It is staged and deployed only to this dev gateway.
GIT_MODULE_SOURCE=~/whiskeyhouse/whk-environment-orchestration/Git-unsigned.modl

# Must exactly match the directory name under projects/ after the project is created.
IGNITION_PROJECT=example-project
